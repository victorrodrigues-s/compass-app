# ─────────────────────────────────────────────────────────────────────────────
# Tarifas — API pública de passagens (Ignav)
# ─────────────────────────────────────────────────────────────────────────────
# Chave em https://ignav.com/signup (1.000 requisições grátis).
# SEM esta chave o app cai num stub offline com preços FICTÍCIOS — serve para
# desenvolvimento, nunca para usuário real.
IGNAV_API_KEY=

# Mercado da busca: define moeda e precificação regional.
IGNAV_MARKET=BR

# Antecedência da pesquisa, em dias. Fixa de propósito: se variasse, dois
# visitantes no mesmo trecho veriam números diferentes e o cache não acertaria.
IGNAV_LEAD_DAYS=21

# Desconto aplicado sobre a tarifa de mercado para chegar ao "valor Onfly".
# É uma premissa comercial, não um preço medido — o report apresenta assim.
ONFLY_DISCOUNT_PERCENT=8.9

# ─────────────────────────────────────────────────────────────────────────────
# HubSpot — UM formulário só
# ─────────────────────────────────────────────────────────────────────────────
# Os três pontos de contato do funil (quiz completo, "falar com especialista",
# CNPJ do "testar grátis") submetem para o MESMO formulário. O HubSpot casa
# pelo e-mail e atualiza o mesmo contato — não precisa de um form por etapa.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_ID_STEP1=
# Opcional. Com token, usa o endpoint /secure/submit (recomendado em produção).
HUBSPOT_PRIVATE_APP_TOKEN=
# Portais na UE usam https://api-eu1.hsforms.com
HUBSPOT_BASE_URL=https://api.hsforms.com

# Mesmo portal ID, exposto ao browser para carregar o script de tracking
# que grava o cookie hubspotutk (necessário para atribuição de campanha).
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Links de conversão
# ─────────────────────────────────────────────────────────────────────────────
# Usado como fallback (cadastro manual) se o fluxo PLG abaixo falhar.
NEXT_PUBLIC_TRIAL_URL=https://app.onfly.com.br/cadastro
NEXT_PUBLIC_MEETING_URL=https://meetings.hubspot.com/onfly

# ─────────────────────────────────────────────────────────────────────────────
# Fluxo PLG (onfly-joyride-flow) — teste grátis com aprovação automática
# ─────────────────────────────────────────────────────────────────────────────
# Formulário/portal SEPARADO do HUBSPOT_FORM_ID_STEP1 acima — de propósito,
# esse fluxo de aprovação usa form próprio (ver lib/plg/hubspot-plg.ts).
# Confirme se é o mesmo portal do Compass ou um portal diferente antes de
# preencher — não assuma.
HUBSPOT_PLG_PORTAL_ID=
HUBSPOT_PLG_FORM_ID=
# Opcional — se vazio, cai pra HUBSPOT_PRIVATE_APP_TOKEN. Só funciona se
# esse token tiver acesso (escopo de leitura de companies) no portal onde
# esse fluxo roda.
HUBSPOT_PLG_PRIVATE_APP_TOKEN=

# APIs da própria plataforma Onfly — NUNCA usadas no browser, só em rotas
# de API server-side (ver lib/plg/onfly-api.ts).
# ⚠️ Payload de /register/company não está documentado no projeto.md de
# origem — confirme os campos reais antes de ir pra produção.
ONFLY_API_KEY=
# X-API-Key do endpoint /edit-company (payload confirmado).
ONFLY_EDIT_COMPANY_KEY=
# ⚠️ Header de auth de /employee-create ainda NÃO confirmado no projeto.md
# de origem ("Em verificação"). Implementado como Bearer — pode estar
# errado, valide antes de confiar nisso em produção.
ONFLY_EMPLOYEE_API_KEY=
